# Puerto HTTP de la API (desarrollo local).
PORT=3000

# Conexión MySQL usada por Prisma. Los valores coinciden con docker-compose.yml
# y solo sirven para desarrollo local; nunca reutilizar en entornos compartidos.
DATABASE_URL="mysql://cocina:cocina_dev_password@localhost:3306/cocina_dev"

# Las pruebas de integración (`npm run test:e2e -w api`) usan por defecto la
# base aislada cocina_test del mismo contenedor; véase test/test-env.ts.

# Client ID de OAuth de tipo "Aplicación web" de Google Cloud. Es la audiencia
# de los ID tokens que obtiene la app; véase docs/google-sign-in-setup.md.
GOOGLE_CLIENT_ID="000000000000-ejemplo.apps.googleusercontent.com"

# Secreto con el que se firman los JWT de acceso (mínimo 32 caracteres).
# Genera uno propio por entorno, por ejemplo:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="cambia-este-valor-por-un-secreto-aleatorio"

# Duración del JWT de acceso, en segundos, y del refresh token, en días.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Intentos permitidos por IP y ventana en registro e inicio de sesión.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
