// Prisma schema. The connection URL is configured in prisma7.config.ts.
// Models are added by the user stories that need them, always through
// versioned migrations (`prisma migrate dev`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  // Google's stable account identifier. Null until the account signs in
  // with Google. Independent of the password: an account can have both.
  googleSub    String?  @unique @db.VarChar(255)
  // Stored trimmed and in lower case: one account per email, whatever the
  // sign-in method.
  email        String   @unique @db.VarChar(320)
  // Null for accounts that have not set a password.
  passwordHash String?  @db.VarChar(255)
  name         String?  @db.VarChar(255)
  avatarUrl    String?  @db.VarChar(2048)
  // Null while the user has not chosen a diet.
  diet         Diet?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens          RefreshToken[]
  ingredientPreferences  IngredientPreference[]
  allergenRestrictions   AllergenRestriction[]
  ingredientRestrictions IngredientRestriction[]
  nutritionGoals         NutritionGoal[]
  inventoryItems         InventoryItem[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  // Tokens issued by rotating the same sign-in share a family, so reusing a
  // revoked token can revoke every descendant.
  familyId  String    @db.Char(36)
  // SHA-256 of the opaque token, hex encoded. The token itself is never stored.
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum Diet {
  VEGETARIAN
  VEGAN
  PESCATARIAN
  FLEXITARIAN
}

enum IngredientCategory {
  VEGETABLE
  FRUIT
  MEAT
  FISH_SEAFOOD
  DAIRY_EGG
  GRAIN
  LEGUME
  NUT_SEED
  HERB_SPICE
  OTHER
}

// Units a quantity can be expressed in. Only units of the same kind convert
// into each other (src/units/units.ts); see
// docs/decisions/0005-unidades-y-equivalencias.md.
enum Unit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  TABLESPOON
  TEASPOON
  PIECE
  PINCH
  PACKAGE
}

// Catalogue of foods the user can refer to. Its rows are reference data,
// inserted by migrations so every environment has the same ones.
model Ingredient {
  id                 String             @id @default(cuid())
  // In Spanish, as shown to the user.
  name               String             @unique @db.VarChar(100)
  category           IngredientCategory
  // True for processed foods whose recipe changes with the brand: the
  // allergens listed are the usual ones, not all it may contain.
  allergensUncertain Boolean            @default(false)
  // The unit the food is usually measured in, offered first to the user.
  // A suggestion only: any unit can be used.
  defaultUnit        Unit
  createdAt          DateTime           @default(now())

  preferences  IngredientPreference[]
  allergens    IngredientAllergen[]
  restrictions IngredientRestriction[]
  aliases      IngredientAlias[]
  inventory    InventoryItem[]

  @@map("ingredients")
}

// Other names of a catalogue food (regional variants, common plurals), so a
// search finds it by any of them. An alias names exactly one food.
model IngredientAlias {
  alias        String     @id @db.VarChar(100)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_aliases")
}

enum IngredientPreferenceKind {
  LIKED
  AVOIDED
}

// A taste, not a safety restriction: allergies and intolerances are kept
// apart from these.
model IngredientPreference {
  userId       String
  ingredientId String
  kind         IngredientPreferenceKind
  createdAt    DateTime                 @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  // One row per ingredient: it cannot be liked and avoided at once.
  @@id([userId, ingredientId])
  @@index([ingredientId])
  @@map("ingredient_preferences")
}

// The 14 allergens the EU requires to declare (Regulation 1169/2011), then
// common intolerances.
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGG
  FISH
  PEANUTS
  SOY
  MILK
  TREE_NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
  LACTOSE
  FRUCTOSE
  HISTAMINE
  SORBITOL
}

// What each ingredient of the catalogue contains. Reference data, inserted
// by migrations like the catalogue itself.
model IngredientAllergen {
  ingredientId String
  allergen     Allergen

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergen])
  @@index([allergen])
  @@map("ingredient_allergens")
}

// Safety restrictions of a user: what they must not eat. Kept apart from the
// ingredient preferences, which are only tastes.
model AllergenRestriction {
  userId    String
  allergen  Allergen
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, allergen])
  @@map("allergen_restrictions")
}

model IngredientRestriction {
  userId       String
  ingredientId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@index([ingredientId])
  @@map("ingredient_restrictions")
}

enum NutritionGoalKind {
  DAILY_CALORIES
  MEAL_CALORIES
  DAILY_PROTEIN
}

// One row per goal the user has set. A goal that is switched off keeps its
// value but must not be applied.
model NutritionGoal {
  userId    String
  kind      NutritionGoalKind
  // Kilocalories or grams, depending on the kind.
  value     Int
  enabled   Boolean           @default(true)
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
  @@map("nutrition_goals")
}

// A food the user has at home. The same food can appear several times (say,
// one opened pack and one closed). The quantity is optional: null means the
// user did not say how much there is, and then the unit is null too.
model InventoryItem {
  id           String     @id @default(cuid())
  userId       String
  ingredientId String
  quantity     Decimal?   @db.Decimal(10, 3)
  unit         Unit?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ingredientId])
  @@map("inventory_items")
}
