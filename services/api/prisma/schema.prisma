// Prisma schema. The connection URL is configured in prisma7.config.ts.
// Models are added by the user stories that need them, always through
// versioned migrations (`prisma migrate dev`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(cuid())
  // Google's stable account identifier. The email can change, so it is not
  // used as the identity and is not unique.
  googleSub String   @unique @db.VarChar(255)
  email     String   @db.VarChar(320)
  name      String?  @db.VarChar(255)
  avatarUrl String?  @db.VarChar(2048)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  // Tokens issued by rotating the same sign-in share a family, so reusing a
  // revoked token can revoke every descendant.
  familyId  String    @db.Char(36)
  // SHA-256 of the opaque token, hex encoded. The token itself is never stored.
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
