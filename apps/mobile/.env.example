# URL base de la API. Desde un teléfono físico, `localhost` es el propio
# teléfono: usa la IP del ordenador en la red local (p. ej. http://192.168.1.10:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Client ID de OAuth de tipo "Aplicación web" de Google Cloud. Debe ser el mismo
# valor que GOOGLE_CLIENT_ID en la API; véase docs/google-sign-in-setup.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com

# Client ID de OAuth de tipo "iOS". Solo hace falta para iOS; déjalo vacío
# hasta que exista la credencial.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
